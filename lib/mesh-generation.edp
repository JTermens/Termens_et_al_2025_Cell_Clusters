// ============================================================================
// lib/meshes.edp
//
// FreeFem++ module for the numerical simulations associated with:
//
//   Térmens, J., Pi-Jaumà, I., Lavi, I., Matejčić, M., Fortunato, I. C., Trepat, X., and
//   Casademunt, J. "Cell clusters sense their global shape to drive collective migration."
//   arXiv preprint arXiv:2509.15910. (2025)
//
// This file is part of the demo code accompanying the manuscript submission.
// It is intended to illustrate the numerical pipeline and is not optimized
// for large-scale production runs.
//
// Author: Joan Térmens
// Last update: 20 Jan 2026
//
// Requirements:
//   - FreeFem++ v4.12 or compatible
//   - GSL (for spline interpolation, if applicable)
//
// Usage:
//   This file is not meant to be executed standalone.
//   It is included by `solver_pv.edp`.

// This module defines helper functions to generate closed 2D meshes with
// prescribed geometric features (cuts, smooth junctions, symmetry axes).
//
// ============================================================================

// ----------------------------------------------------------------------------
// All meshes are assumed to be:
//   - planar
//   - simply connected
//   - oriented counterclockwise
//
// Length scales are expressed in physical units consistent with the solver.
//
// ----------------------------------------------------------------------------


func mesh oneCutSmooth(
  int bndDensity, real cut, real r0, real rArch, real symmAxis, int labelBnd, 
  real lengthScale, real Nmax
){
  /*
  [mesh] oneCutSmooth generates a closed circular boundary with a single straight 
  cut of angular width `cut`, centered around the direction `symmAxis`.

  The endpoints of the cut are smoothed using circular arcs of radius `rArch`
  to avoid curvature singularities, which would otherwise degrade remeshing
  quality and FEM convergence.

  Angular quantities are expressed in radians, with symmAxis measured from
  the x-axis.

  Warning:
    - Large values of `cut` or small `rArch` may lead to self-intersections
      or poor element quality.

  Parameters:
  - real bndDensity: boundary density, num. of points per unit lenght at the 
  boundary.
  - real cut: angluar length of the straight cut line.
  - real r0: radius of the circumference (Front) arch.
  - real rArch: radius of the tangential arches that smooth the cut vertices. 
  - real symmAxis: orientation of the shape. Defines the mid-line of the cut.
  - int labelBnd: free boundary label.
  - real lengthScale: length scale to adimensionalize the mesh (x, y /= L).
  - real Nmax: Maximum number of points per border piece.

  * Return type: mesh
  */

  real cutAxis = symmAxis+pi;
  real t1 = acos((cos(cut/2.)-(rArch/r0))/(1-(rArch/r0)));

  real OxRight = (r0-rArch)*cos(cutAxis+t1);
  real OyRight = (r0-rArch)*sin(cutAxis+t1);
  real OxLeft = (r0-rArch)*cos(cutAxis-t1);
  real OyLeft = (r0-rArch)*sin(cutAxis-t1);
  real lenCut = sqrt((OxRight-OxLeft)*(OxRight-OxLeft) + (OyRight-OyLeft)*(OyRight-OyLeft));

  border GammaArchLeft(t=0,1){
    x = (OxLeft+rArch*cos(cutAxis-t1*(1-t)))/lengthScale; 
    y = (OyLeft+rArch*sin(cutAxis-t1*(1-t)))/lengthScale; 
    label = labelBnd;
  };

  border GammaCut(t=0,1){
    x = ((OxLeft+rArch*cos(cutAxis))+(OxRight-OxLeft)*t)/lengthScale;
    y = ((OyLeft+rArch*sin(cutAxis))+(OyRight-OyLeft)*t)/lengthScale;
    label = labelBnd;
  };

  border GammaArchRight(t=0,1){
    x = (OxRight+rArch*cos(cutAxis+t1*t))/lengthScale; 
    y = (OyRight+rArch*sin(cutAxis+t1*t))/lengthScale;
    label = labelBnd;
  };

  border GammaArchFront(t=0,1){
    x = (r0*cos(cutAxis+t1+2*(pi-t1)*t))/lengthScale;
    y = (r0*sin(cutAxis+t1+2*(pi-t1)*t))/lengthScale;
    label = labelBnd;
  };

  mesh Th=buildmesh(
    GammaArchLeft(min(Nmax, bndDensity*rArch*t1/lengthScale))
    + GammaCut(min(Nmax, bndDensity*lenCut/lengthScale))
    + GammaArchRight(min(Nmax, bndDensity*rArch*t1/lengthScale))
    + GammaArchFront(min(Nmax, bndDensity*r0*2*(pi-t1)/lengthScale))
  );

  return Th;
}
