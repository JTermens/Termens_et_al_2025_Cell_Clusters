Cell[CellGroupData[{

Cell["Custom read of .txt and .msh files", "Subsection",
 CellChangeTimes->{{3.881639947634253*^9, 3.881639974240425*^9}, 
   3.950784196161902*^9, 
   3.95078438845531*^9},ExpressionUUID->"c785a404-9a45-41eb-9e39-\
d45ec70079c4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "The", " ", "functions", " ", "defined", " ", "here", " ", "to", " ", 
     "read", " ", "files", " ", "are", " ", "designed", " ", "to", " ", "be", 
     " ", "roboust", " ", "and", " ", "properly", " ", "work", " ", 
     "regardless", " ", "of", " ", "the", " ", "compression", " ", "or", " ", 
     "owner", " ", "of", " ", "the", " ", "simulation", " ", "results"}], ";", 
    RowBox[{
     RowBox[{"-", " ", "We"}], " ", "use", " ", 
     RowBox[{"Import", "[", "]"}], " ", "OVER", " ", 
     RowBox[{"OpenRead", "[", "]"}], " ", "as", " ", "the", " ", "second", " ",
      "one", " ", "does", " ", "not", " ", "work", " ", "with", " ", "files", 
     " ", "owened", " ", "by", " ", "root", " ", 
     RowBox[{"(", 
      RowBox[{
      "such", " ", "as", " ", "the", " ", "ones", " ", "generated", " ", "in",
        " ", "a", " ", "devcontainer"}], ")"}]}], ";", "\[IndentingNewLine]", 
    
    RowBox[{
     RowBox[{"-", " ", "We"}], " ", "parse", " ", "the", " ", "lines", " ", 
     "with", " ", 
     RowBox[{"ReadList", "[", "]"}], " ", "over", " ", 
     RowBox[{"ToExpression", "[", "]"}], " ", "as", " ", "the", " ", "latter",
      " ", "sometimes", " ", "has", " ", "given", " ", "us", " ", "problems", 
     " ", "with", " ", "machine", " ", "size", " ", "numbers"}], ";"}], "  ", 
   "\[IndentingNewLine]", "*)"}], "\[IndentingNewLine]", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Parser", " ", "of", " ", "a", " ", "string", " ", "line", " ", "with", " ",
     "number", " ", "separated", " ", "by", " ", "whitespace"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"readLine", "[", "line_", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"strm", ",", "lineData"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"strm", "=", 
        RowBox[{"StringToStream", "[", "line", "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lineData", "=", 
        RowBox[{"First", "[", 
         RowBox[{"ReadList", "[", 
          RowBox[{"strm", ",", "Number", ",", 
           RowBox[{"RecordLists", "->", "True"}]}], "]"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Close", "[", "strm", "]"}], ";", "\[IndentingNewLine]", 
       "lineData"}]}], "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Custom", " ", "read", " ", "of", " ", "a", " ", "txt", " ", "file"}], ",",
      " ", 
     RowBox[{"skips", " ", "the", " ", "headers", " ", 
      RowBox[{"(", 
       RowBox[{"first", " ", "nheader", " ", "lines"}], ")"}], " ", "and", " ",
       "reads", " ", "everything", " ", "else", " ", "as", " ", "numbers"}], ",",
      " ", 
     RowBox[{
     "while", " ", "converting", " ", "lines", " ", "into", " ", "lists"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReadFile", "[", 
     RowBox[{"filename_", ",", 
      RowBox[{"nheader_", ":", "0"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"lines", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"lines", "=", 
        RowBox[{"Import", "[", 
         RowBox[{"filename", ",", "\"\<Lines\>\""}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"lines", "=", 
        RowBox[{"Drop", "[", 
         RowBox[{"lines", ",", "nheader"}], "]"}]}], ";", 
       RowBox[{"(*", 
        RowBox[{"Drop", " ", "the", " ", "header", " ", "lines"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"Map", "[", 
         RowBox[{"readLine", ",", "lines"}], "]"}]}], ";", 
       "\[IndentingNewLine]", "data"}]}], "\n", "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Custom", " ", "read", " ", "of", " ", 
      RowBox[{"an", " ", ".", "msh"}], " ", 
      RowBox[{"file", ".", " ", "Colud"}], " ", "save", " ", "the", " ", 
      "mesh", " ", "labels", " ", "and", " ", "returns", " ", "nV", " ", 
      RowBox[{"(", 
       RowBox[{"num", ".", " ", "vertices"}], ")"}]}], ",", " ", 
     RowBox[{"nT", " ", 
      RowBox[{"(", 
       RowBox[{"num", ".", "triangles"}], ")"}]}], ",", " ", 
     RowBox[{"nbE", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"num", ".", " ", "boundary"}], " ", "edges"}], ")"}]}], ",", 
     " ", 
     RowBox[{
     "together", " ", "with", " ", "lists", " ", "of", " ", "the", " ", 
      "vertices"}], ",", " ", 
     RowBox[{"triangles", " ", "and", " ", "boundary", " ", 
      RowBox[{"edges", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ReadMshFile", "[", 
     RowBox[{"filename_", ",", 
      RowBox[{"saveLabels_", ":", "False"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "data", ",", "nV", ",", "nT", ",", "nbE", ",", "iniIndex", ",", 
        "lastCol", ",", "meshVertices", ",", "meshTriangles", ",", 
        "bmeshEdges"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"data", "=", 
        RowBox[{"ReadFile", "[", 
         RowBox[{"filename", ",", "0"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
        "read", " ", "the", " ", "msh", " ", "file", " ", "using", " ", "our",
          " ", "custom", " ", "ReadFile", " ", "function"}], "*)"}], 
       "\[IndentingNewLine]", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "initial", " ", "index", " ", "of", " ", "the", " ", "lines", " ", 
         "to", " ", "parse"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"iniIndex", "=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"if", " ", "saveLabels"}], "=", "False"}], ",", " ", 
         RowBox[{"lastCol", "=", 
          RowBox[{
           RowBox[{"-", "2"}], " ", "avoids", " ", "saving", " ", "the", " ", 
           
           RowBox[{"labels", ".", " ", "Else"}]}]}], ",", " ", 
         RowBox[{"lastCol", "=", 
          RowBox[{
           RowBox[{"-", "1"}], " ", "and", " ", "labels", " ", "are", " ", 
           "saved"}]}]}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"lastCol", "=", 
        RowBox[{"If", "[", 
         RowBox[{"saveLabels", ",", 
          RowBox[{"-", "1"}], ",", 
          RowBox[{"-", "2"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"nV", " ", "=", " ", 
          RowBox[{"num", ".", " ", "vertices"}]}], ",", " ", 
         RowBox[{"nT", " ", "=", " ", 
          RowBox[{"num", ".", " ", "triangles"}]}], ",", " ", 
         RowBox[{"nbE", " ", "=", " ", 
          RowBox[{
           RowBox[{"num", ".", " ", "boundary"}], " ", "edges"}]}]}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"nV", ",", "nT", ",", "nbE"}], "}"}], "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", "iniIndex", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"(*", 
        RowBox[{"Parse", " ", "the", " ", 
         RowBox[{"vertices", "'"}], " ", "positions"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"iniIndex", "+=", "1"}], ";", "\[IndentingNewLine]", 
       RowBox[{"meshVertices", "=", 
        RowBox[{"data", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"iniIndex", ";;", 
            RowBox[{"nV", "+", 
             RowBox[{"(", 
              RowBox[{"iniIndex", "-", "1"}], ")"}]}]}], ",", 
           RowBox[{";;", "lastCol"}]}], "]"}], "]"}]}], ";", " ", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
          RowBox[{"selects", " ", "from", " ", "2", " ", 
           RowBox[{"(", 
            RowBox[{"staring", " ", "index"}], ")"}], " ", "of", " ", "the", " ",
            "vertices", " ", "to", " ", 
           RowBox[{"(", 
            RowBox[{"2", "-", "1"}], ")"}]}], "+", 
          RowBox[{
          "nV", " ", "which", " ", "is", " ", "the", " ", "index", " ", "of", 
           " ", "the", " ", "last", " ", "vertex"}]}], ")"}], "*)"}], 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"Parse", " ", "the", " ", "mesh", " ", "triangles"}], "*)"}], 
       "\[IndentingNewLine]", 
