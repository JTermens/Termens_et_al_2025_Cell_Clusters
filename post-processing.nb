Cell[CellGroupData[{

Cell["\<\
Dynamic plots of the local variables (visualize temporal evolutions)\
\>", "Subsubsection",
 CellChangeTimes->{{3.95058520127284*^9, 3.950585221824821*^9}, {
  3.9505853194098597`*^9, 
  3.950585357514224*^9}},ExpressionUUID->"3031adb8-21f1-4fdc-a439-\
296d2e8fa680"],

Cell["\<\
Here, we could either use a native tool from mathematica, like Manipulate, or \
export a time evolution as a gif. Take care with Manipulate, as it consumes a \
lot of memory size.\
\>", "Text",
 CellChangeTimes->{{3.950666070223699*^9, 
  3.9506661851099987`*^9}},ExpressionUUID->"004a88c2-ecf0-4bd3-b3c7-\
1b113f9ed9b2"],

Cell[BoxData[
 RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"plotFrame", "[", 
    RowBox[{"simulName", ",", "frame", ",", "field", ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"-", "500"}], ",", "500"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "800"}], "}"}]}], "}"}], ",", "Automatic", ",", 
     RowBox[{"2", " ", 
      RowBox[{"colSize", "/", "3"}]}]}], "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Grid", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Control", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"field", ",", "\"\<y-vel\>\""}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\"\<y-vel\>\"", ",", "\"\<y-trac\>\""}], "}"}]}], "}"}], 
        "]"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Control", "[", 
         RowBox[{"{", 
          RowBox[{"frame", ",", "1", ",", 
           RowBox[{"params", "[", 
            RowBox[{"[", 
             RowBox[{"simulName", ",", "\"\<limitFrame\>\""}], "]"}], "]"}], ",",
            "1"}], "}"}], "]"}], ",", "SpanFromLeft", ",", "SpanFromLeft"}], 
       "}"}]}], "}"}], "]"}]}], "\[IndentingNewLine]", "]"}]], "Input",
 CellChangeTimes->{{3.95066652982102*^9, 3.950666558516399*^9}, {
   3.9506665952148857`*^9, 3.9506666066536617`*^9}, 3.9785278790085363`*^9, {
   3.9785331797409*^9, 
   3.9785331851497917`*^9}},ExpressionUUID->"430ac98a-6ddc-4f99-9ea6-\
ea2ae659040c"],

Cell["\<\
Export the evolutions of both velocities and tractions as gifs (gifs usually \
take a while to render and export).\
\>", "Text",
 CellChangeTimes->{{3.9506666368000107`*^9, 3.950666666653811*^9}, {
  3.95066718123138*^9, 
  3.950667199299161*^9}},ExpressionUUID->"d2ed09af-ffe8-4b0d-851f-\
54c253c607e9"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gifSimul", "[", 
     RowBox[{"simulName_", ",", "field_", ",", "range_", ",", "plotSize_"}], 
     "]"}], ":=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"plotFrame", "[", 
       RowBox[{
       "simulName", ",", "frame", ",", "field", ",", "range", ",", 
        "Automatic", ",", "plotSize"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"frame", ",", "1", ",", 
        RowBox[{"lastFrame", "[", "]"}], ",", "1"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Export", " ", "the", " ", "gifs", " ", "for", " ", "the", " ", 
    "semicircle"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"field", "=", "\"\<y-vel\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"ToString", "[", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"pathResults", ",", 
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\</gifs/``_``.gif\>\"", ",", "simulName", ",", "field"}], 
        "]"}]}], "}"}], "]"}], "]"}], ",", 
   RowBox[{"gifSimul", "[", 
    RowBox[{"simulName", ",", "field", ",", "range", ",", 
     RowBox[{"2", " ", 
      RowBox[{"colSize", "/", "3"}]}]}], "]"}], ",", 
   RowBox[{"ImageResolution", "->", "120"}], ",", 
   RowBox[{"AnimationRepetitions", "->", "Infinity"}], ",", 
   RowBox[{"\"\<DisplayDurations\>\"", "->", 
    RowBox[{".02", "*", "gsplit"}]}]}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"field", "=", "\"\<y-trac\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Export", "[", 
  RowBox[{
   RowBox[{"ToString", "[", 
    RowBox[{"Row", "[", 
     RowBox[{"{", 
      RowBox[{"pathResults", ",", 
       RowBox[{"StringForm", "[", 
        RowBox[{"\"\</gifs/``_``.gif\>\"", ",", "simulName", ",", "field"}], 
        "]"}]}], "}"}], "]"}], "]"}], ",", 
   RowBox[{"gifSimul", "[", 
    RowBox[{"simulName", ",", "field", ",", "range", ",", 
     RowBox[{"2", " ", 
      RowBox[{"colSize", "/", "3"}]}]}], "]"}], ",", 
   RowBox[{"ImageResolution", "->", "120"}], ",", 
   RowBox[{"AnimationRepetitions", "->", "Infinity"}], ",", 
   RowBox[{"\"\<DisplayDurations\>\"", "->", 
    RowBox[{".02", "*", "gsplit"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9506666888959513`*^9, 3.950666953929698*^9}, 
   3.950667313528891*^9, {3.950667367996296*^9, 3.950667393835088*^9}, {
   3.950667846065377*^9, 3.950667874599279*^9}, {3.978527827336327*^9, 
   3.9785278548798943`*^9}, {3.978533295575424*^9, 3.978533298238825*^9}, {
   3.978534235526116*^9, 3.978534242589823*^9}},
 CellLabel->
  "In[153]:=",ExpressionUUID->"58ffe1da-cafc-44ca-ae88-3bd3235e524f"],

Cell[BoxData["\<\"semicircle_test_plots/gifs/semicircle_test_y-vel.gif\"\>"], \
"Output",
 CellChangeTimes->{3.950667328293992*^9, 3.95066737323545*^9, 
  3.9506674150139112`*^9, 3.978534282253972*^9},
 CellLabel->
  "Out[155]=",ExpressionUUID->"408e623c-0113-4375-a7cc-4ac24ab34fea"],

