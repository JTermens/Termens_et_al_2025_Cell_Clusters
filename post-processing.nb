Cell[TextData[{
 "Main FreeFem++ script for the demo simulations associated with:\n\nTermens \
et al. (2025) ",
 StyleBox["Cell clusters sense their global shape to drive collective \
migration",
  FontSlant->"Italic"],
 "\n\nThis notebook:\n - defines the physical and numerical parameters\n - \
runs a representative simulation\n - writes output files to disk for \
post-processing\n\n Author: Joan T\[EAcute]rmens\nLast update: 26 Jan 2026\n\n\
Input:\n-  ",
 Cell[BoxData[
  RowBox[{
   RowBox[{".", 
    RowBox[{"/", "semicircle_test"}]}], "/"}]], "InlineCode",ExpressionUUID->
  "ead8cf24-fdbc-439d-996d-f2aa3bdfe813"],
 " from ",
 Cell[BoxData[
  RowBox[{"solver_pv", ".", "edp"}]], "InlineCode",ExpressionUUID->
  "dab6214c-3fca-4a52-82fe-edcc77234eab"],
 " or\n- ",
 Cell[BoxData[
  RowBox[{".", 
   RowBox[{"/", 
    RowBox[{"semicircle_test", ".", "tar", ".", "xz"}]}]}]], "InlineCode",
  ExpressionUUID->"58f2ce16-39e1-4082-bc4e-4e7d5a507a62"],
 "\n\nOutput:\n- Results are written to the directory specified by \
`rootDir/simulName`."
}], "Text",
 CellChangeTimes->{{3.978496808603594*^9, 3.9784969471625834`*^9}, {
  3.978497019819663*^9, 3.97849709037999*^9}, {3.978497279990839*^9, 
  3.978497280206662*^9}},ExpressionUUID->"1853131d-398d-476b-82f6-\
8a4f6253c8ce"],

