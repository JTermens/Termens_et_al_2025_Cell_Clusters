Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "At", " ", "this", " ", "point", " ", "we", " ", "have", " ", "arrays", " ",
      "of", " ", "both", " ", "time", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", "s"}], ")"}], " ", "and", " ", "velocities", " ", 
     RowBox[{"(", 
      RowBox[{"in", " ", 
       RowBox[{"\[Mu]m", "/", "s"}]}], ")"}]}], ",", " ", "positions", ",", 
    " ", 
    RowBox[{
     RowBox[{"etc", ".", " ", "We"}], " ", "want", " ", "to", " ", "combine", 
     " ", "both", " ", "and", " ", "to", " ", "change", " ", "the", " ", 
     "units", " ", "to", " ", 
     RowBox[{"\[Mu]m", "/", "h"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"\[CapitalDelta]Ycm", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", " ", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"x", "-", "coordinate"}], ",", " ", 
          RowBox[{"change", " ", "units", " ", "to", " ", "h"}]}], "*)"}], 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Ycm\>\""}], "]"}], " ", "-", 
         RowBox[{
          RowBox[{"globalSols", "[", 
           RowBox[{"simulName", ",", "\"\<Ycm\>\""}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], 
       RowBox[{"(*", 
        RowBox[{"y", "-", "coordinate"}], "*)"}], "\[IndentingNewLine]", 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"relativeArea", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Area\>\""}], "]"}], "/", 
         RowBox[{
          RowBox[{"globalSols", "[", 
           RowBox[{"simulName", ",", "\"\<Area\>\""}], "]"}], "[", 
          RowBox[{"[", "1", "]"}], "]"}]}]}], " ", "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Ix", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Ix\>\""}], "]"}], " ", "/", 
         "10000"}]}], "}"}], "]"}]}], ";"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Divide", " ", "by", " ", 
      RowBox[{"10", "^", "5"}], " ", "to", " ", "avoid", " ", "large", " ", 
      "numbers", " ", "in", " ", "the", " ", "y"}], "-", "axis"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Iy", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Iy\>\""}], "]"}], " ", "/", 
         "10000"}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Change", " ", "units", " ", "to", " ", "h", " ", "and", " ", "divide", " ",
       "by", " ", "friction"}], ",", " ", 
     RowBox[{"so", " ", 
      FractionBox["1", "\[Xi]"], 
      RowBox[{"\[Integral]", 
       RowBox[{
        SubscriptBox["\[Zeta]", "i"], 
        RowBox[{"(", "y", ")"}], 
        SubscriptBox["p", "y"], 
        RowBox[{"\[DifferentialD]", "S"}]}]}]}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"TractionIntegralY", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"3600", "/", 
           RowBox[{"\[Xi]", "[", "simulName", "]"}]}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Tyavg\>\""}], "]"}]}]}], "}"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"SpreadIntegralY", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{"(", "3600", ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<divTermsY\>\""}], "]"}]}]}], " ", 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"VcmY", "[", "simulName_", "]"}], ":=", 
     RowBox[{"Transpose", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"1", "/", "3600"}], ")"}], " ", 
         RowBox[{"globalSols", "[", 
          RowBox[{"simulName", ",", "\"\<Time\>\""}], "]"}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"3600", "/", 
            RowBox[{"\[Xi]", "[", "simulName", "]"}]}], ")"}], " ", 
          RowBox[{"globalSols", "[", 
           RowBox[{"simulName", ",", "\"\<Tyavg\>\""}], "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", "3600", ")"}], " ", 
          RowBox[{"globalSols", "[", 
           RowBox[{"simulName", ",", "\"\<divTermsY\>\""}], "]"}]}]}]}], 
       "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
     "Here", " ", "we", " ", "compute", " ", "the", " ", "Vcm", " ", "from", " ",
       "the", " ", "formula"}], ",", " ", 
     RowBox[{
      RowBox[{
       SubscriptBox["V", "CM"], " ", "=", " ", 
       RowBox[{
        FractionBox["1", "A"], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           FractionBox["1", "\[Xi]"], 
           RowBox[{"\[Integral]", 
            RowBox[{
             SubscriptBox["\[Zeta]", "i"], 
             RowBox[{"(", "y", ")"}], 
             SubscriptBox["p", "y"], 
             RowBox[{"\[DifferentialD]", "S"}]}]}]}], "+", 
          RowBox[{"\[Integral]", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"y", "-", 
              SubscriptBox["Y", "CM"]}], ")"}], 
            RowBox[{"\[Del]", "\[CenterDot]", "v"}], 
            RowBox[{"\[DifferentialD]", "S"}]}]}]}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"but", " ", "there", " ", "are", " ", "other", " ", "options"}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"-", " ", 
       RowBox[{
       "Vycm", " ", "is", " ", "the", " ", "Vcm", " ", "computed", " ", 
        "with", " ", "a", " ", "numeric", " ", "derivative"}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       SubsuperscriptBox["V", 
        RowBox[{"CM", ",", "y"}], "n"], "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          SubsuperscriptBox["Y", "CM", "n"], "-", 
          SubsuperscriptBox["Y", "CM", 
           RowBox[{"n", "-", "1"}]]}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox["t", "n"], "-", 
          SuperscriptBox["t", 
           RowBox[{"n", "-", "1"}]]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
       RowBox[{"-", " ", "Vyavg"}], " ", "is", " ", 
       FractionBox["1", "A"], 
       RowBox[{"\[Integral]", 
        RowBox[{
         SubscriptBox["v", "y"], 
         RowBox[{"\[DifferentialD]", "S"}], " ", "and", " ", "could", " ", 
         "be", " ", "used", " ", "instead", " ", "of", " ", "the", " ", 
         "traction", " ", "integral"}]}]}]}], ",", " ", 
     RowBox[{
      RowBox[{
       RowBox[{
       "as", " ", "force", " ", "balance", " ", "implies", " ", "\[Xi]", 
        RowBox[{"\[Integral]", 
         RowBox[{
          SubscriptBox["v", "y"], 
          RowBox[{"\[DifferentialD]", "S"}]}]}]}], " ", "=", " ", 
       RowBox[{"\[Integral]", 
        RowBox[{
         SubscriptBox["\[Zeta]", "i"], " ", 
         SubscriptBox["p", "y"], 
         RowBox[{"\[DifferentialD]", "S"}]}]}]}], ";", "\[IndentingNewLine]", 
      
      RowBox[{
      "If", " ", "the", " ", "results", " ", "do", " ", "not", " ", "make", " ",
        "sense", " ", "it", " ", "could", " ", "be", " ", "convenient", " ", 
       "to", " ", "check", " ", "that", " ", "the", " ", "force", " ", 
       "balance", " ", "is", " ", 
       RowBox[{"satisfyed", "."}]}]}]}], "\[IndentingNewLine]", "*)"}], " ", 
   "\[IndentingNewLine]"}]}]], "Input",
